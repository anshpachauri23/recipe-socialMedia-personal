# Frontend Environment Variables
# Local development:
#   NEXT_PUBLIC_API_URL=http://localhost:8080/api
# Production (Vercel):
NEXT_PUBLIC_API_URL=https://your-backend.northflank.app/api

# Backend Environment Variables (set on the Northflank service, not here)
# Database — Northflank Postgres addon. In production these are wired up via
# "Linked secrets" on the service (POSTGRES_HOST → DB_HOST, etc.). For local
# dev, point at the addon's PUBLIC connection string with sslmode=require.
DB_HOST=your-database-host
DB_PORT=5432
DB_USER=your-database-user
DB_PASSWORD=your-secure-password
DB_NAME=your-database-name
DB_SSLMODE=require
JWT_SECRET=your-super-secret-jwt-key

# AWS S3 — bucket in us-east-1 with public-read on the recipe-images/* prefix
S3_REGION=us-east-1
S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
