# Local Development Environment Variables
# Backend Configuration
PORT=8080

# Database Configuration
# For local dev, use the Northflank Postgres addon's PUBLIC connection details
# (Addon → Connection details → External). In production on Northflank, these
# are populated from the addon's linked secrets and use the internal host.
DB_HOST=your-addon-host.northflank.app
DB_PORT=5432
DB_USER=your-username
DB_PASSWORD=your-password
DB_NAME=your-database
DB_SSLMODE=require

# JWT Configuration
# Generate a secure random string for production
JWT_SECRET=your-jwt-secret-key-here

# AWS S3 Configuration
S3_BUCKET=your-s3-bucket-name
S3_REGION=us-east-1

# AWS Credentials
# IAM user `recipe-social-backend-s3` — least-privilege (PutObject + GetObject
# on recipe-images/* only). Create the access key in IAM Console.
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
